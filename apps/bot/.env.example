# ─── Discord ─────────────────────────────────────────────────────────────────
DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=

# Canal donde se publica el banner de bienvenida.
# Hoy está codificado en events/guildMemberAdd.js; se parametriza en la Fase 5.
WELCOME_CHANNEL_ID=

# Canal de foro donde viven los hilos de tareas.
FORUM_CHANNEL_ID=

# Rol asignado tras completar /verificar.
ROLE_ID=

# ─── Supabase ────────────────────────────────────────────────────────────────
# Mismo proyecto que la web, pero aquí las variables NO llevan prefijo NEXT_PUBLIC_.
SUPABASE_URL=https://<project-ref>.supabase.co
# El bot usa service_role para escribir saltándose RLS.
SUPABASE_KEY=

# ─── Servidor keep-alive (Render) ────────────────────────────────────────────
PORT=3000
SUPABASE_PING_INTERVAL_HOURS=12

# ⚠️ Secreto COMPARTIDO con la web. En apps/web se llama DISCORD_SYNC_TOKEN.
#    Ambos valores deben ser idénticos o la sincronización falla en silencio.
SYNC_SECRET_TOKEN=
