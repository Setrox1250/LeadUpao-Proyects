# ─── Supabase ────────────────────────────────────────────────────────────────
# Expuestas al navegador: NUNCA poner aquí claves con privilegios.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo servidor (Server Actions). Omite RLS por completo: no exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Sincronización con el bot de Discord ────────────────────────────────────
# URL pública del servicio del bot en Render, sin barra final.
DISCORD_BOT_URL=https://<servicio>.onrender.com

# ⚠️ Secreto COMPARTIDO con el bot. En apps/bot se llama SYNC_SECRET_TOKEN.
#    Ambos valores deben ser idénticos o la sincronización falla en silencio.
DISCORD_SYNC_TOKEN=
